PHBOX_PORT=8080
PHBOX_DATA=/var/lib/phbox/data
PHBOX_INI=/var/lib/phbox/php.ini
# Shared secret between web and runner (required, >= 16 chars).
# deploy.sh replaces this placeholder automatically.
RUNNER_TOKEN=change-me-to-a-long-random-string
# Optional runner capacity knobs
MAX_CONCURRENT_RUNS=4
MAX_QUEUED_RUNS=16
MAX_SESSION_DISK_BYTES=209715200
